 UnbufferedDrawer::~UnbufferedDrawer()
 {
+#ifdef __EMSCRIPTEN__
+	if (m_vbo != 0) {
+		GLuint buffers[2] = { m_vbo, m_ebo };
+		glDeleteBuffers(2, buffers);
+	}
+#endif
+}
+
+void UnbufferedDrawer::_uploadVertices(const void * _vertices, u32 _bytes)
+{
+#ifdef __EMSCRIPTEN__
+	if (m_vbo == 0) {
+		GLuint buffers[2];
+		glGenBuffers(2, buffers);
+		m_vbo = buffers[0];
+		m_ebo = buffers[1];
+	}
+	glBindBuffer(GL_ARRAY_BUFFER, m_vbo);
+	glBufferData(GL_ARRAY_BUFFER, _bytes, _vertices, GL_STREAM_DRAW);
+	m_base = static_cast<const u8*>(_vertices);
+#endif
+}
+
+void UnbufferedDrawer::_attribPointer(u32 _index, s32 _size, u32 _type, bool _normalized, s32 _stride, const void * _ptr)
+{
+#ifdef __EMSCRIPTEN__
+	// The vertices are in m_vbo (bound by _uploadVertices): the pointer becomes an offset into them.
+	// The attribute keeps m_vbo as its buffer, so the cache of pointers stays valid across draws
+	const GLintptr offset = static_cast<const u8*>(_ptr) - m_base;
+	glVertexAttribPointer(_index, _size, GLenum(_type), _normalized ? GL_TRUE : GL_FALSE, _stride, reinterpret_cast<const void*>(offset));
+#else
+	glVertexAttribPointer(_index, _size, GLenum(_type), _normalized ? GL_TRUE : GL_FALSE, _stride, _ptr);
+#endif
+}
+
+void UnbufferedDrawer::_drawElements(u32 _mode, s32 _count, u32 _type, const void * _elements, u32 _elementsBytes, u32 _offset)
+{
+#ifdef __EMSCRIPTEN__
+	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, m_ebo);
+	if (_offset == 0)
+		glBufferData(GL_ELEMENT_ARRAY_BUFFER, _elementsBytes, _elements, GL_STREAM_DRAW);
+	glDrawElements(GLenum(_mode), _count, GLenum(_type), reinterpret_cast<const void*>(GLintptr(_offset)));
+	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+#else
+	glDrawElements(GLenum(_mode), _count, GLenum(_type), static_cast<const u8*>(_elements) + _offset);
+#endif
+}
+
+void UnbufferedDrawer::_endDraw()
+{
+#ifdef __EMSCRIPTEN__
+	// Same state as without the buffer: the attributes keep pointing into m_vbo
+	glBindBuffer(GL_ARRAY_BUFFER, 0);
+#endif
 }
 
